use std::sync::Arc;
use axum::{
    extract::{Path, State},
    http::StatusCode,
    response::IntoResponse,
    Json, Router,
    routing::{get, post},
};
use serde::Deserialize;
use crate::ports::inbound::{{ snake_name }}_service::{{ service_trait_name }};

#[derive(Clone)]
pub struct AppState {
    pub service: Arc<dyn {{ service_trait_name }}>,
}

#[derive(Deserialize)]
pub struct CreatePayload {
    pub name: String,
}

pub fn routes(state: AppState) -> Router {
    Router::new()
        .route("/{{ snake_name }}s", post(create_handler).get(list_handler))
        .route("/{{ snake_name }}s/{id}", get(get_handler))
        .with_state(state)
}

async fn get_handler(
    Path(id): Path<String>,
    State(state): State<AppState>,
) -> Result<impl IntoResponse, (StatusCode, String)> {
    match state.service.get(&id).await {
        Ok(item) => Ok((StatusCode::OK, Json(item))),
        Err(err) => Err((StatusCode::NOT_FOUND, err.to_string())),
    }
}

async fn create_handler(
    State(state): State<AppState>,
    Json(payload): Json<CreatePayload>,
) -> Result<impl IntoResponse, (StatusCode, String)> {
    match state.service.create(payload.name).await {
        Ok(item) => Ok((StatusCode::CREATED, Json(item))),
        Err(err) => Err((StatusCode::BAD_REQUEST, err.to_string())),
    }
}

async fn list_handler(
    State(state): State<AppState>,
) -> Result<impl IntoResponse, (StatusCode, String)> {
    match state.service.list().await {
        Ok(items) => Ok((StatusCode::OK, Json(items))),
        Err(err) => Err((StatusCode::INTERNAL_SERVER_ERROR, err.to_string())),
    }
}
