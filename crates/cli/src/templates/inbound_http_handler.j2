use std::sync::Arc;
use axum::{
    extract::{Path, State},
    http::StatusCode,
    response::IntoResponse,
    Json, Router,
    routing::{delete, get, post, put},
};
use serde::{Deserialize, Serialize};
use crate::ports::inbound::{{ snake_name }}_service::{{ service_trait_name }};

#[derive(Clone)]
pub struct AppState {
    pub service: Arc<dyn {{ service_trait_name }}>,
}

#[derive(Deserialize)]
pub struct CreatePayload {
    pub name: String,
}

#[derive(Deserialize)]
pub struct UpdatePayload {
    pub name: String,
}

#[derive(Serialize)]
pub struct ErrorResponse {
    pub error: String,
}

pub fn routes(state: AppState) -> Router {
    Router::new()
        .route("/{{ snake_name }}s", post(create_handler).get(list_handler))
        .route("/{{ snake_name }}s/{id}", get(get_handler).put(update_handler).delete(delete_handler))
        .route("/health", get(health_handler))
        .with_state(state)
}

async fn health_handler() -> impl IntoResponse {
    (StatusCode::OK, Json(serde_json::json!({ "status": "ok" })))
}

async fn get_handler(
    Path(id): Path<String>,
    State(state): State<AppState>,
) -> Result<impl IntoResponse, (StatusCode, Json<ErrorResponse>)> {
    state.service.get(&id).await
        .map(|item| (StatusCode::OK, Json(item)))
        .map_err(|e| (StatusCode::NOT_FOUND, Json(ErrorResponse { error: e.to_string() })))
}

async fn create_handler(
    State(state): State<AppState>,
    Json(payload): Json<CreatePayload>,
) -> Result<impl IntoResponse, (StatusCode, Json<ErrorResponse>)> {
    state.service.create(payload.name).await
        .map(|item| (StatusCode::CREATED, Json(item)))
        .map_err(|e| (StatusCode::UNPROCESSABLE_ENTITY, Json(ErrorResponse { error: e.to_string() })))
}

async fn update_handler(
    Path(id): Path<String>,
    State(state): State<AppState>,
    Json(payload): Json<UpdatePayload>,
) -> Result<impl IntoResponse, (StatusCode, Json<ErrorResponse>)> {
    state.service.update(&id, payload.name).await
        .map(|item| (StatusCode::OK, Json(item)))
        .map_err(|e| (StatusCode::BAD_REQUEST, Json(ErrorResponse { error: e.to_string() })))
}

async fn delete_handler(
    Path(id): Path<String>,
    State(state): State<AppState>,
) -> Result<impl IntoResponse, (StatusCode, Json<ErrorResponse>)> {
    state.service.delete(&id).await
        .map(|_| StatusCode::NO_CONTENT.into_response())
        .map_err(|e| (StatusCode::NOT_FOUND, Json(ErrorResponse { error: e.to_string() })))
}

async fn list_handler(
    State(state): State<AppState>,
) -> Result<impl IntoResponse, (StatusCode, Json<ErrorResponse>)> {
    state.service.list().await
        .map(|items| (StatusCode::OK, Json(items)))
        .map_err(|e| (StatusCode::INTERNAL_SERVER_ERROR, Json(ErrorResponse { error: e.to_string() })))
}
